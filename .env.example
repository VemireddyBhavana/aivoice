# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:your-password@db.xxxxxx.supabase.co:5432/postgres?schema=public"

# Telephony (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Speech-to-Text (Deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Text-to-Speech (ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_voice_id

# Large Language Model (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Payments (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Queue / Caching (Upstash Redis)
REDIS_URL=rediss://default:your-password@your-db.upstash.io:6379
